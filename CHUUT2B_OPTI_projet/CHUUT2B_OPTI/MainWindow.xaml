<Window x:Class="CHUUT2B_OPTI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CHUUT2B OPTI" Width="1280" Height="820"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="CHUUT2B OPTI" FontSize="32" FontWeight="Bold"/>
                <TextBlock Text="Gaming PC Audit &amp; Safe Optimizer" Foreground="{StaticResource Muted}" FontSize="14" Margin="2,3,0,0"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Text="PRÊT" HorizontalAlignment="Right"
                       Foreground="{StaticResource Good}" FontWeight="Bold" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,22,0,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="14" Padding="18">
                <StackPanel>
                    <TextBlock Text="SCORE GAMING" Foreground="{StaticResource Muted}" FontWeight="Bold"/>
                    <TextBlock x:Name="ScoreText" Text="--" FontSize="48" FontWeight="Bold" Margin="0,3"/>
                    <TextBlock x:Name="ScoreHint" Text="Aucun test effectué" Foreground="{StaticResource Muted}"/>
                </StackPanel>
            </Border>
            <StackPanel Grid.Column="1" Margin="20,0">
                <TextBlock x:Name="SummaryText" Text="Lance un diagnostic complet de ton PC." FontSize="18" VerticalAlignment="Center"/>
                <ProgressBar x:Name="ScanProgress" Height="10" Margin="0,18,0,0" Minimum="0" Maximum="100"/>
            </StackPanel>
            <Button Grid.Column="2" x:Name="ScanButton" Content="LANCER LE TEST" Click="Scan_Click" Height="58" VerticalAlignment="Center"
                    Background="{StaticResource Accent}" FontWeight="Bold"/>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="14" Padding="12">
            <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" HeadersVisibility="Column"
                      Background="{StaticResource Panel}" Foreground="{StaticResource Text}"
                      BorderThickness="0" GridLinesVisibility="Horizontal" IsReadOnly="True"
                      RowBackground="{StaticResource Panel}" AlternatingRowBackground="{StaticResource Panel2}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ÉTAT" Binding="{Binding Status}" Width="80"/>
                    <DataGridTextColumn Header="CATÉGORIE" Binding="{Binding Category}" Width="140"/>
                    <DataGridTextColumn Header="ÉLÉMENT" Binding="{Binding Title}" Width="220"/>
                    <DataGridTextColumn Header="DÉTAILS" Binding="{Binding Details}" Width="*"/>
                    <DataGridTextColumn Header="ACTION" Binding="{Binding Recommendation}" Width="330"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="Diagnostic en lecture seule • Les réparations seront toujours proposées avant application." Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ExportButton" Content="EXPORTER LE RAPPORT" Click="Export_Click" IsEnabled="False"/>
                <Button x:Name="OptimizeButton" Content="OPTIMISER EN SÉCURITÉ" Click="Optimize_Click" IsEnabled="False"
                        Background="#203328"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
